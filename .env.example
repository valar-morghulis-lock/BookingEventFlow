# ============================================================
# BookingEventFlow - Local Development
# ============================================================

# Spring
SPRING_PROFILES_ACTIVE=dev

# Infrastructure
POSTGRES_VERSION=17

# Event Service
EVENT_SERVICE_PORT=8081

# Event Database
EVENT_DB_NAME=event_service
EVENT_DB_USERNAME=event_service
EVENT_DB_PASSWORD=change-me
EVENT_DB_PORT=5432

# Database connection used by Spring Boot
EVENT_DB_URL=jdbc:postgresql://event-service-db:5432/event_service