# ============================================================
# BookingEventFlow - Local Development
# ============================================================

# Spring
SPRING_PROFILES_ACTIVE=dev

# Infrastructure
POSTGRES_VERSION=17

# ============================================================
# Event Service
# ============================================================

EVENT_SERVICE_PORT=8081

EVENT_DB_NAME=event_service
EVENT_DB_USERNAME=event_service
EVENT_DB_PASSWORD=change-me
EVENT_DB_PORT=5432
EVENT_DB_URL=jdbc:postgresql://localhost:5432/event_service

# ============================================================
# Reservation Service
# ============================================================

RESERVATION_SERVICE_PORT=8082

RESERVATION_DB_NAME=reservation_service
RESERVATION_DB_USERNAME=reservation_service
RESERVATION_DB_PASSWORD=change-me
RESERVATION_DB_PORT=5433
RESERVATION_DB_URL=jdbc:postgresql://localhost:5433/reservation_service

# ============================================================
# Kafka
# ============================================================

KAFKA_VERSION=3.8.0
KAFKA_HOST_PORT=29092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# ============================================================
# Kafka Connect / Debezium
# ============================================================

DEBEZIUM_VERSION=2.7.3.Final
KAFKA_CONNECT_PORT=8083

# ============================================================
# Kafka UI
# ============================================================

KAFKA_UI_VERSION=latest
KAFKA_UI_PORT=8090

# ============================================================
# Outbox Connector
# ============================================================
# Read by register-outbox-connector.ps1/.sh via envsubst — NOT
# interpolated by docker-compose itself.

OUTBOX_DB_USERNAME=event_service
OUTBOX_DB_PASSWORD=change-me
OUTBOX_DB_NAME=event_service